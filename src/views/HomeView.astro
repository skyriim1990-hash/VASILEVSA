---
import Media from '../components/Media.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { useTranslations, path } from '../i18n/utils.js';
import { artworks, homepageArtworks, artworkIndex } from '../data/content.js';
import { displayAlt, displayTitle } from '../utils/display.js';

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

/* Four, because .spread__cell--1 … --4 below place exactly four cells on the
   grid. It is a fact about the composition, not an assumption about how much
   work exists — homepageArtworks returns fewer when there are fewer. */
const shortlist = homepageArtworks(4);

/**
 * The three works of the opening collage, in the order the composition places
 * them: one large frame, then the two smaller ones beside it.
 *
 * Each is resolved from the archive by slug. Until those works are imported,
 * the frame stands as a marked placeholder carrying the title of the painting
 * that belongs in it, in the proportions that painting's frame will keep — so
 * importing them changes the pictures and nothing about the layout.
 *
 * The image slots in Admin → Homepage are deliberately not read here: they
 * still hold the previous project's demo files, which do not belong to this
 * archive. Reconnecting that override is a decision for when the real files
 * are uploaded.
 */
const HERO = [
  { slug: 'sunflowers', title: 'Sunflowers', ratio: '3 / 4', tone: 1 },
  { slug: 'irises', title: 'Irises', ratio: '4 / 3', tone: 3 },
  /* 5 / 4 rather than a square: the painting is 1.263 wide, and a 1:1 frame
     cropped a fifth of its width, taking the moon with it. */
  { slug: 'the-starry-night', title: 'The Starry Night', ratio: '5 / 4', tone: 2 },
];

const heroSlot = (spec) => {
  const work = artworks.find((a) => a.id === spec.slug && a.image);
  const index = work ? artworkIndex(work.id) : '';

  return {
    ...spec,
    src: work?.image ?? '',
    alt: work ? displayAlt(work, t, index) : '',
    /* The route is the same one ArtworkCard builds for the spread below, via
       the same helper, so the two halves of the page cannot disagree about a
       work's URL. Empty while the slot has no work — see linkFor. */
    href: work ? path(`/works/${work.id}`, lang) : '',
    label: work ? displayTitle(work, t, index) : spec.title,
  };
};

const [main, sideTop, sideBottom] = HERO.map(heroSlot);

/**
 * Wraps a collage frame in a link, or in nothing.
 *
 * An `a` when the slot holds a work, a Fragment when it does not. A frame
 * still waiting for its painting has no detail page to open, and an anchor
 * pointing at one would be a focus stop that leads to a 404 — worse than not
 * being a link at all.
 *
 * The spread below already links, because ArtworkCard is itself an anchor.
 */
const linkFor = (s) =>
  s.href
    ? { Tag: 'a', attrs: { href: s.href, 'aria-label': s.label, class: 'opening__link' } }
    : { Tag: Fragment, attrs: {} };

const mainLink = linkFor(main);
const sideTopLink = linkFor(sideTop);
const sideBottomLink = linkFor(sideBottom);

/* The About teaser's portrait, resolved by slug like the collage above. */
const portrait = artworks.find((a) => a.id === 'self-portrait-with-grey-felt-hat' && a.image) ?? null;
const portraitAlt = portrait ? displayAlt(portrait, t, artworkIndex(portrait.id)) : '';
---

{/* ================================================== OPENING SPREAD */}
<section class="opening">
  <div class="shell opening__inner">
    <div class="opening__head">
      <h1 class="opening__name display">
        <span class="reveal-line"><span>{t('home.title1')}</span></span>
        <span class="reveal-line" data-delay="1"><span>{t('home.title2')}<span class="dot">.</span></span></span>
      </h1>
    </div>

    <div class="opening__say">
      <p class="opening__statement serif reveal">{t('home.statement')}</p>

      <p class="body opening__intro reveal" data-delay="2">{t('home.lead')}</p>

      <div class="opening__cta reveal" data-delay="3">
        <a class="link" href={path('/works', lang)}>
          <span>{t('common.viewAll')}</span>
        </a>
      </div>
    </div>

    <div class="opening__collage">
      <div class="opening__main reveal">
        <mainLink.Tag {...mainLink.attrs}>
          <Media
            src={main.src}
            alt={main.alt}
            ratio={main.ratio}
            label={main.title}
            shortLabel={main.title}
            tone={main.tone}
            priority={true}
            sizes="(max-width: 760px) 92vw, 30vw"
          />
        </mainLink.Tag>
        {/* "Awaiting photography" under an actual painting contradicts
            itself. The caption belongs to the empty state only. */}
        {!main.src && <p class="opening__caption micro">{t('ph.awaiting')}</p>}
      </div>

      <div class="opening__side">
        <div class="reveal" data-delay="1">
          <sideTopLink.Tag {...sideTopLink.attrs}>
            <Media
              src={sideTop.src}
              alt={sideTop.alt}
              ratio={sideTop.ratio}
              label={sideTop.title}
              shortLabel={sideTop.title}
              tone={sideTop.tone}
              priority={true}
              sizes="(max-width: 760px) 45vw, 22vw"
            />
          </sideTopLink.Tag>
        </div>
        <div class="reveal" data-delay="2">
          <sideBottomLink.Tag {...sideBottomLink.attrs}>
            <Media
              src={sideBottom.src}
              alt={sideBottom.alt}
              ratio={sideBottom.ratio}
              label={sideBottom.title}
              shortLabel={sideBottom.title}
              tone={sideBottom.tone}
              priority={true}
              sizes="(max-width: 760px) 45vw, 22vw"
            />
          </sideBottomLink.Tag>
        </div>
      </div>
    </div>
  </div>
</section>

{/* ================================================== SELECTED WORKS */}
<section class="section home-field on-tone" aria-labelledby="selected">
  <div class="shell">
    <SectionHeader id="selected" label={t('home.selected')} note={t('home.selectedNote')} />

    <div class="spread">
      {
        shortlist.map((artwork, i) => (
          <div class:list={['spread__cell', `spread__cell--${i + 1}`, 'reveal']} data-delay={String((i % 3) + 1)}>
            <ArtworkCard
              artwork={artwork}
              index={artworkIndex(artwork.id)}
              lang={lang}
              tone={(i % 4) + 1}
              sizes="(max-width: 720px) 92vw, 40vw"
            />
          </div>
        ))
      }
    </div>

    <div class="spread__foot reveal">
      <a class="link" href={path('/works', lang)}>
        <span>{t('home.exploreCta')}</span>
      </a>
    </div>
  </div>
</section>

{/* ================================================== PERIODS */}
{/* One line and a link, on its own sheet of paper. The band that stood here
    introduced a project with a photograph, statistics and a paragraph; the
    periods need none of that on the homepage, because the page they lead to
    is itself the introduction. */}
<section class="periods-band on-tone" aria-labelledby="periods-band">
  <div class="shell periods-band__inner">
    <p class="micro micro--accent reveal">{t('home.periodsLabel')}</p>
    <h2 class="h1 periods-band__title reveal" id="periods-band" data-delay="1">{t('home.periodsNote')}</h2>

    <div class="periods-band__foot reveal" data-delay="2">
      <a class="link" href={path('/periods', lang)}>
        <span>{t('home.periodsCta')}</span>
      </a>
    </div>
  </div>
</section>

{/* ================================================== ABOUT TEASER */}
<section class="section" aria-labelledby="about-teaser">
  <div class="shell about-teaser">
    <div class="about-teaser__media reveal">
      <Media
        src={portrait?.image ?? ''}
        alt={portraitAlt}
        ratio={portrait?.ratio || '4 / 5'}
        label={t('ph.artwork')}
        tone={2}
        kind="portrait"
        note={portrait ? '' : t('ph.awaiting')}
        sizes="(max-width: 860px) 70vw, 28vw"
      />
    </div>

    <div class="about-teaser__text">
      <h2 class="h2 about-teaser__title reveal" id="about-teaser">{t('home.aboutTitle')}</h2>
      <p class="body reveal" data-delay="1">{t('home.aboutLead')}</p>
      <div class="about-teaser__cta reveal" data-delay="2">
        <a class="link" href={path('/about', lang)}>
          <span>{t('home.aboutCta')}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* ------------------------------------------------------------- opening */

  /* The editorial opening spread: the name and the text that belongs to it in
     a column on the left, the three works composed as a collage on the right.
     The composition is asymmetric on purpose — the large frame leads, the two
     smaller ones sit lower in a narrower column beside it. Below 1025px the
     same pieces stack (see the tablet block). */
  .opening {
    position: relative;
    padding-top: clamp(2.5rem, 6vw, 5.5rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .opening__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    grid-template-areas:
      'head collage'
      'say  collage';
    grid-template-rows: auto 1fr;
    column-gap: clamp(2rem, 5vw, 5.5rem);
    row-gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  .opening__head {
    grid-area: head;
  }

  .opening__say {
    grid-area: say;
  }

  .opening__collage {
    grid-area: collage;
    display: grid;
    grid-template-columns: 1.32fr 1fr;
    gap: var(--gap);
    align-items: start;
  }

  /* The display step is set against the full shell; here the name has 0.92 of
     roughly half of it. "van Gogh" is the longer of the two lines at about 5.1
     times its own font size, so the rate is carried down until that line ends
     inside the column and the name stays on the two lines it is written as.
     The floor and ceiling are the display step's own, so phones and very wide
     screens are unchanged. */
  .opening__name {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    font-size: clamp(3.1rem, 7.2vw, 7.4rem);
  }

  .opening__name .dot {
    /* the single loudest use of the accent on the whole site */
    color: var(--accent);
  }

  .opening__statement {
    font-size: clamp(1.4rem, 2.3vw, 2.1rem);
    line-height: 1.18;
    letter-spacing: -0.012em;
    color: var(--ink);
  }

  .opening__intro {
    margin-top: clamp(1.25rem, 2.2vw, 1.85rem);
    max-width: 42ch;
  }

  .opening__cta {
    display: flex;
    justify-content: flex-end;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    /* the link sits right-aligned in its column, against the collage */
    padding-right: clamp(0rem, 3vw, 3rem);
  }

  .opening__caption {
    margin-top: 0.85rem;
    color: var(--ink-faint);
  }

  .opening__side {
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 2.25rem);
    /* drops the smaller pair below the top of the large frame, which is what
       keeps the collage asymmetric */
    margin-top: clamp(2rem, 6vw, 5rem);
  }

  /* The anchor wrapping a small frame. `display: block` is the whole rule:
     an inline anchor around a block figure sits on a text baseline and adds a
     few pixels of line-height under the image, which would shift the
     composition. Colour, decoration and the focus ring are inherited from
     global.css, so the frames look and behave exactly as they did. */
  .opening__link {
    display: block;
  }

  /* ------------------------------------------------------------- spread */

  .spread {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: clamp(3rem, 7vw, 6.5rem);
  }

  /* a hung wall, not a row of cards: four different widths, four heights */
  .spread__cell--1 { grid-column: 1 / span 5; }
  .spread__cell--2 { grid-column: 7 / span 4; margin-top: clamp(2rem, 7vw, 6rem); }
  .spread__cell--3 { grid-column: 2 / span 4; }
  .spread__cell--4 { grid-column: 7 / span 5; margin-top: clamp(1rem, 4vw, 3.5rem); }

  .spread__foot {
    display: flex;
    justify-content: flex-end;
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  /* ------------------------------------------------ the page's fields */

  /* .on-tone rides along in the markup because the grey text tokens are set
     against --paper: on #E7E5DF, --ink-faint falls to 3.86:1 and --accent-ink
     to 4.06:1, both under AA. The class steps them down. Nothing about the
     type changes; it is the same hierarchy, corrected for the sheet it is
     printed on. */
  .home-field {
    background: var(--paper-deep);
  }

  /* ------------------------------------------------------------- periods */

  /* The deepest tone on the homepage, and the only place it appears — the one
     section a visitor can point at between two fields of paper. */
  .periods-band {
    background: var(--paper-tint);
    padding-block: var(--section);
    margin-block: 0;
  }

  /* Where paper meets the band, one section's worth of air is enough: the
     tone change is already the boundary. */
  .section:has(+ .periods-band) {
    padding-bottom: var(--section-tight);
  }

  .periods-band + .section {
    padding-top: var(--section-tight);
  }

  .periods-band__title {
    margin-top: clamp(0.85rem, 2vw, 1.4rem);
    max-width: 18ch;
  }

  .periods-band__foot {
    display: flex;
    justify-content: flex-start;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  /* ------------------------------------------------------------- about */

  .about-teaser {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }

  .about-teaser__title {
    max-width: 15ch;
    margin-bottom: clamp(1.25rem, 2.5vw, 2rem);
  }

  .about-teaser__cta {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  /* ============================================================= tablet */

  @media (max-width: 1024px) {
    /* One column, in reading order: the name, the work that leads the page,
       the text, then the two smaller works side by side under it. */
    .opening__inner {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'head'
        'main'
        'say'
        'side';
      row-gap: clamp(2rem, 5vw, 3rem);
    }

    /* the collage steps out of the layout so the outer grid can place the
       large frame and the smaller pair separately, with the text between them */
    .opening__collage {
      display: contents;
    }

    /* the size the single column has always used */
    .opening__name {
      font-size: clamp(2.728rem, 7.5vw, 7.9rem);
    }

    /* Capped rather than full-bleed. The lead frame is a portrait format, so
       at the full width of a tablet column it stands 900px tall and pushes the
       text that introduces it off the screen entirely. Left-aligned at this
       width, which also keeps the stack asymmetric. */
    .opening__main {
      grid-area: main;
      width: min(100%, 30rem);
    }

    .opening__side {
      grid-area: side;
      align-self: start;
      grid-template-columns: 1fr 1fr;
      align-items: start;
      gap: clamp(0.75rem, 3vw, 1.25rem);
      margin-top: 0;
    }

    .opening__cta {
      justify-content: flex-start;
      padding-right: 0;
    }

    .spread__cell--1 { grid-column: 1 / span 7; }
    .spread__cell--2 { grid-column: 8 / span 5; }
    .spread__cell--3 { grid-column: 1 / span 5; }
    .spread__cell--4 { grid-column: 6 / span 7; }

    .about-teaser {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      align-items: start;
    }
  }

  /* ============================================================= mobile */

  @media (max-width: 680px) {
    .opening {
      padding-bottom: clamp(3rem, 10vw, 4rem);
    }

    /* the collage is recomposed, not collapsed: one lead image, then the two
       smaller works side by side underneath */
    .opening__main {
      padding-right: 12%;
    }

    .opening__side {
      /* enough inset to keep the collage asymmetric, not so much that the
         two smaller works shrink out of the composition */
      padding-left: 11%;
    }

    .opening__statement {
      font-size: clamp(1.35rem, 6.5vw, 1.9rem);
    }

    .spread {
      grid-template-columns: minmax(0, 1fr);
      row-gap: clamp(2.5rem, 9vw, 3.5rem);
    }

    /* keep a deliberate hierarchy in the single column */
    .spread__cell--1,
    .spread__cell--2,
    .spread__cell--3,
    .spread__cell--4 {
      grid-column: 1 / -1;
      margin-top: 0;
    }

    .spread__cell--2 { padding-left: 22%; }
    .spread__cell--3 { padding-right: 26%; }
    .spread__cell--4 { padding-left: 12%; }

    .spread__foot {
      justify-content: flex-start;
    }

    .about-teaser {
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(1.75rem, 7vw, 2.5rem);
    }

    .about-teaser__media {
      width: 68%;
    }
  }
</style>
