---
import ContactForm from '../components/ContactForm.astro';
import { useTranslations } from '../i18n/utils.js';

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

const enquiries = [t('contact.e1'), t('contact.e2'), t('contact.e3'), t('contact.e4')];
---

<section class="contact">
  <div class="shell">
    <div class="contact__row">
      <p class="micro reveal">{t('nav.contact')}</p>
      <p class="micro contact__loc reveal" data-delay="1">{t('site.location')}</p>
    </div>

    <h1 class="contact__title h1">
      <span class="reveal-line"><span>{t('contact.title')}</span></span>
    </h1>

    <div class="contact__body">
      <aside class="contact__aside">
        <p class="body reveal">{t('contact.lead')}</p>

        <ul class="contact__list reveal" data-delay="1">
          {enquiries.map((e) => <li>{e}</li>)}
        </ul>

        <p class="contact__pending micro reveal" data-delay="2">{t('contact.detailsPending')}</p>
      </aside>

      <div class="contact__form reveal" data-delay="1">
        <ContactForm lang={lang} />
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-top: clamp(3rem, 8vw, 7rem);
    padding-bottom: clamp(4rem, 9vw, 8rem);
  }

  .contact__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--gap);
    padding-bottom: clamp(1.5rem, 4vw, 3rem);
    border-bottom: 1px solid var(--rule);
  }

  .contact__loc {
    color: var(--ink-faint);
  }

  .contact__title {
    padding-top: clamp(1.75rem, 4vw, 3rem);
    max-width: 14ch;
  }

  .contact__body {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    padding-top: clamp(3rem, 7vw, 6rem);
  }

  .contact__list {
    list-style: none;
    margin: clamp(1.75rem, 3vw, 2.5rem) 0 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .contact__list li {
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--rule);
    font-size: var(--fs-small);
    color: var(--ink);
  }

  .contact__pending {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    letter-spacing: 0.08em;
    text-transform: none;
    line-height: 1.65;
    color: var(--ink-faint);
    max-width: 34ch;
  }

  @media (max-width: 860px) {
    .contact__body {
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(2.5rem, 8vw, 3.5rem);
    }
  }

  @media (max-width: 560px) {
    .contact__title {
      max-width: 100%;
    }
  }
</style>
