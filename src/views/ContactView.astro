---
import { useTranslations } from '../i18n/utils.js';

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

const email = t('contact.email');
---

<section class="contact">
  <div class="shell">
    <div class="contact__row">
      <p class="micro reveal">{t('contact.title')}</p>
      <p class="micro contact__loc reveal" data-delay="1">{t('site.location')}</p>
    </div>

    <h1 class="contact__title h1">
      <span class="reveal-line"><span>{t('contact.title')}</span></span>
    </h1>

    <div class="contact__body">
      <div class="contact__prose">
        <p class="lead reveal">{t('contact.p1')}</p>
        <p class="body reveal" data-delay="1">{t('contact.p2')}</p>
      </div>

      <aside class="contact__aside reveal" data-delay="2">
        <p class="micro contact__label">{t('contact.p3')}</p>
        <p class="contact__email">
          <a href={`mailto:${email}`}>{email}</a>
        </p>
      </aside>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-top: clamp(3rem, 8vw, 7rem);
    padding-bottom: clamp(4rem, 9vw, 8rem);
  }

  .contact__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--gap);
    padding-bottom: clamp(1.5rem, 4vw, 3rem);
    border-bottom: 1px solid var(--rule);
  }

  .contact__loc {
    color: var(--ink-faint);
  }

  .contact__title {
    padding-top: clamp(1.75rem, 4vw, 3rem);
    max-width: 14ch;
  }

  /* The reading column leads; the address sits beside it as a colophon rather
     than as a call to action. */
  .contact__body {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    padding-top: clamp(3rem, 7vw, 6rem);
  }

  .contact__prose {
    max-width: 58ch;
  }

  .contact__prose .body {
    margin-top: clamp(1.25rem, 2.4vw, 1.85rem);
    color: var(--ink-soft);
  }

  .contact__aside {
    padding-top: 0.4rem;
  }

  .contact__label {
    color: var(--ink-faint);
    letter-spacing: 0.08em;
    text-transform: none;
    line-height: 1.65;
  }

  .contact__email {
    margin-top: clamp(0.85rem, 1.8vw, 1.25rem);
    padding-top: clamp(0.85rem, 1.8vw, 1.25rem);
    border-top: 1px solid var(--rule);
    font-size: var(--fs-lead);
    /* an address is a long unbroken token on a narrow screen */
    overflow-wrap: anywhere;
  }

  .contact__email a {
    color: var(--ink);
    transition: color 400ms var(--ease);
  }

  .contact__email a:hover {
    color: var(--accent-ink);
  }

  @media (max-width: 860px) {
    .contact__body {
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(2.5rem, 8vw, 3.5rem);
    }
  }

  @media (max-width: 560px) {
    .contact__title {
      max-width: 100%;
    }
  }
</style>
