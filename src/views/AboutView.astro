---
import Media from '../components/Media.astro';
import { useTranslations } from '../i18n/utils.js';
import { artworks, artworkIndex } from '../data/content.js';
import { displayAlt } from '../utils/display.js';

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

/* The opening statement is set one sentence per line. Splitting on the
   sentence boundary rather than on a fixed number of parts means a
   translation with two or four sentences still renders — the earlier
   version indexed [0][1][2] and would have printed "undefined." */
const statementLines = t('about.statement')
  .split(/(?<=\.)\s+/)
  .filter(Boolean);

/* The portrait is the self-portrait already in the archive, resolved by slug
   the way the homepage resolves its opening collage. Until that work is
   imported the frame keeps the marked placeholder it has always had. */
const portrait = artworks.find((a) => a.id === 'self-portrait-with-grey-felt-hat' && a.image) ?? null;
const portraitAlt = portrait ? displayAlt(portrait, t, artworkIndex(portrait.id)) : '';

/* Only the facts that were supplied. Nothing is extrapolated. */
const blocks = [
  { title: t('about.b1title'), body: t('about.b1') },
  { title: t('about.b2title'), body: t('about.b2') },
  { title: t('about.b3title'), body: t('about.b3') },
  { title: t('about.b4title'), body: t('about.b4') },
];
---

<!-- ================================================== OPENING -->
<section class="about-open">
  <div class="shell">
    <h1 class="about-open__statement h1">
      {
        statementLines.map((line, i) => (
          <span class="reveal-line" data-delay={i ? String(i) : undefined}>
            <span>{line}</span>
          </span>
        ))
      }
    </h1>
  </div>

  <div class="shell about-open__spread">
    <div class="about-open__portrait reveal">
      <Media
        src={portrait?.image ?? ''}
        alt={portraitAlt}
        ratio={portrait?.ratio || '4 / 5'}
        label={t('ph.artwork')}
        tone={2}
        kind="portrait"
        note={portrait ? '' : t('ph.awaiting')}
        priority={true}
        sizes="(max-width: 860px) 78vw, 34vw"
      />
    </div>

    <div class="about-open__side">
      <p class="lead reveal" data-delay="1">{blocks[0].body}</p>
    </div>
  </div>
</section>

<!-- ================================================== TEXT -->
<section class="section about-text on-tone" aria-label={t('about.title')}>
  <div class="shell">
    {
      blocks.slice(1).map((b) => (
        <article class="chunk">
          <h2 class="micro chunk__label reveal">{b.title}</h2>
          <div class="chunk__body">
            <p class="chunk__lead reveal" data-delay="1">{b.body}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  /* ------------------------------------------------------------- opening */

  .about-open {
    padding-top: 4rem;
  }

  /* Three sentences, one per masked line. The measure was 16ch, written for a
     statement whose longest sentence was two words; the sentence here is 58
     characters and broke across four lines inside it, so the heading read as
     six ragged lines rather than three.

     Two changes carry it: the measure opens up to the column, and the step
     comes down from --fs-h1. At the h1 size no container inside the shell can
     hold 58 characters in two lines — the arithmetic simply does not work — so
     the size is what has to give. It is still the largest type on the page. */
  .about-open__statement {
    padding-top: 0;
    font-size: clamp(1.65rem, 4.2vw, 3.6rem);
    max-width: 30ch;
  }

  .about-open__spread {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: end;
    padding-top: clamp(3rem, 7vw, 6rem);
  }

  .about-open__side {
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 1.85rem);
    padding-bottom: clamp(0rem, 4vw, 3rem);
  }

  /* ------------------------------------------------------------- chunks */

  /* Biography, Philosophy and Practice sit on the secondary tone. The opening
     — statement and portrait — stays on paper, so the page opens light and
     settles into the reading. One step, once; a tone per chunk would turn the
     biography into a stack of cards. */
  .about-text {
    background: var(--paper-deep);
  }

  .chunk {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(1rem, 6vw, 6rem);
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--rule);
  }

  .chunk:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .chunk__label {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    align-self: start;
  }

  .chunk__body {
    max-width: 54ch;
  }

  .chunk__lead {
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--ink);
  }

  .chunk__lead + .body {
    margin-top: 1.35em;
  }

  /* The .about-as* rules that sat here went with the section above. Astro
     scopes this stylesheet to this component, so they styled nothing else;
     /art-sport carries its own. */

  /* ============================================================= responsive */

  @media (max-width: 860px) {
    .about-open__spread {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }

    .about-open__portrait {
      width: 78%;
    }

    .chunk {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }

    .chunk__label {
      position: static;
    }
  }

  @media (max-width: 760px) {
    .about-open {
      padding-top: 4.25rem;
    }
  }

  @media (max-width: 560px) {
    .about-open__statement {
      max-width: 100%;
    }
  }
</style>
