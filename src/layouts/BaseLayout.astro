---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { useTranslations } from '../i18n/utils.js';

const {
  lang = 'en',
  title,
  description,
  /** page-level flag so the homepage can suppress its own name in the title */
  bare = false,
} = Astro.props;

const t = useTranslations(lang);
const pageTitle = bare ? t('meta.title') : `${title} — ${t('site.name')}`;
const metaDescription = description || t('meta.description');

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);

/* Social preview: a 1200×630 crop of Sunflowers (1889), at /og-image.jpg. It is
   resolved against `site`, so the tag carries an absolute URL. */
const ogImage = '/og-image.jpg';
const ogImageAlt = 'Sunflowers, 1889 — a painting by Vincent van Gogh';

/* Structured data: the site itself, as an independent concept archive. It names
   no author or publisher, and describes Van Gogh only in the page copy. */
const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Van Gogh — a concept archive',
  url: (Astro.site ?? new URL(Astro.url.origin)).href,
  description: t('meta.description'),
  inLanguage: 'en',
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical.href} />

    {/* Open Graph / social */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content="en_GB" />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site ?? Astro.url.origin).href} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    {ogImage && <meta name="twitter:image" content={new URL(ogImage, Astro.site ?? Astro.url.origin).href} />}

    <meta name="theme-color" content="#F7F6F2" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/*
      Marks the document as scripted before the first paint. Every entrance
      animation hides its element behind this class, so the hidden state only
      exists when the script that reveals it is actually running. Without
      JavaScript the site renders as ordinary visible content rather than a
      blank page. Inline and in the head on purpose: any later and the
      un-animated content would flash first.
    */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    {/*
      Type: one neutral grotesque, at every size.

      Golos Text covers Latin and Cyrillic in one face, so nothing changes
      shape mid-sentence around a Latin term and the display sizes are set in
      the same family as the body copy. Two more families used to load here —
      Instrument Serif for the Latin display and Prata behind it for Cyrillic,
      which Instrument Serif does not carry. Nothing in the public stylesheets
      asks for either any more, so neither is requested.

      Each subset ships with its own unicode-range, so an English page never
      downloads the Cyrillic files and vice versa.

      A second request used to follow this one, for U+2192 alone, because a
      line of copy on the old project page drew a literal arrow. No public
      page sets that character any more — the arrow beside a link is a rule
      and a rotated square in CSS — so the extra stylesheet is not requested.
    */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Playfair+Display:wght@400&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
  </head>

  <body>
    <a class="skip" href="#main">{t('nav.skip')}</a>
    <Navigation lang={lang} />
    {/* tabindex="-1" so the skip link actually moves focus here; without it
         several browsers scroll but leave focus back in the header */}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      /* Reveal on scroll. One observer for the whole document, unobserving
         each element after it lands — nothing stays subscribed. */
      const items = document.querySelectorAll('.reveal, .reveal-line');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduced || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
