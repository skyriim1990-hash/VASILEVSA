---
import { useTranslations } from '../i18n/utils.js';

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

/**
 * No mailbox or form service has been supplied, so no address is invented.
 * Set `endpoint` to a real form endpoint (Formspree, Basin, a serverless
 * function, anything that accepts a POST) and the form starts delivering —
 * the markup does not change.
 */
const endpoint = '';

const subjects = [t('contact.e1'), t('contact.e2'), t('contact.e3'), t('contact.e4')];
---

<!-- the status strings travel with the markup so the script stays language-
     agnostic; only the browser's own validation messages come from the UA -->
<form
  class="form"
  data-contact-form
  data-endpoint={endpoint}
  data-sending={t('contact.sending')}
  data-sent={t('contact.sent')}
  data-failed={t('contact.failed')}
  novalidate
>
  <div class="form__row">
    <div class="field">
      <label class="field__label micro" for="cf-name">
        {t('contact.name')} <span class="field__req">({t('contact.required')})</span>
      </label>
      <input class="field__input" id="cf-name" name="name" type="text" autocomplete="name" required />
    </div>

    <div class="field">
      <label class="field__label micro" for="cf-email">
        {t('contact.email')} <span class="field__req">({t('contact.required')})</span>
      </label>
      <input class="field__input" id="cf-email" name="email" type="email" autocomplete="email" required />
    </div>
  </div>

  <div class="field">
    <label class="field__label micro" for="cf-subject">{t('contact.subject')}</label>
    <select class="field__input field__input--select" id="cf-subject" name="subject">
      <option value="">{t('contact.selectSubject')}</option>
      {subjects.map((s) => <option value={s}>{s}</option>)}
    </select>
  </div>

  <div class="field">
    <label class="field__label micro" for="cf-message">
      {t('contact.message')} <span class="field__req">({t('contact.required')})</span>
    </label>
    <textarea class="field__input field__input--area" id="cf-message" name="message" rows="5" required></textarea>
  </div>

  <div class="form__foot">
    <button class="submit" type="submit">
      <span class="submit__text">{t('contact.send')}</span>
      <span class="submit__arrow" aria-hidden="true"></span>
    </button>

    <p class="form__status" role="status" aria-live="polite" data-form-status></p>
  </div>

  <p class="form__hint micro" data-form-hint hidden>{t('contact.notConfigured')}</p>
</form>

<style>
  .form {
    display: grid;
    gap: clamp(1.75rem, 3.5vw, 2.75rem);
    width: min(100%, 44rem);
  }

  .form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .field {
    display: grid;
    gap: 0.6rem;
  }

  .field__label {
    color: var(--ink-soft);
  }

  .field__req {
    color: var(--ink-faint);
    letter-spacing: 0.1em;
    text-transform: lowercase;
  }

  /* underline only — no boxes, no radii, no shadows */
  .field__input {
    appearance: none;
    width: 100%;
    padding: 0.55rem 0 0.7rem;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--rule);
    border-radius: 0;
    font-family: var(--sans);
    font-size: var(--fs-body);
    color: var(--ink);
    transition: border-color 400ms var(--ease);
  }

  .field__input:hover {
    border-bottom-color: var(--ink-faint);
  }

  .field__input:focus {
    outline: none;
    border-bottom-color: var(--accent-ink);
  }

  .field__input:focus-visible {
    outline: none;
  }

  .field__input--select {
    /* a single hairline chevron, drawn in CSS rather than an icon font */
    background-image: linear-gradient(45deg, transparent 50%, var(--ink-soft) 50%),
      linear-gradient(135deg, var(--ink-soft) 50%, transparent 50%);
    background-position: right 6px center, right 1px center;
    background-size: 5px 5px, 5px 5px;
    background-repeat: no-repeat;
    padding-right: 1.5rem;
  }

  .field__input--area {
    resize: vertical;
    min-height: 7.5rem;
    line-height: 1.6;
  }

  .field__input[aria-invalid='true'] {
    border-bottom-color: var(--accent-ink);
  }

  .form__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
  }

  .submit {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    appearance: none;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--ink);
    padding: 0 0 0.5rem;
    cursor: pointer;
    font-size: var(--fs-micro);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
    transition: color 400ms var(--ease), border-color 400ms var(--ease);
  }

  .submit:hover,
  .submit:focus-visible {
    color: var(--accent-ink);
    border-bottom-color: var(--accent-ink);
  }

  .submit__arrow {
    width: 2.25rem;
    height: 1px;
    background: currentColor;
    position: relative;
    transition: width 500ms var(--ease);
  }

  .submit__arrow::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    width: 6px;
    height: 6px;
    border-top: 1px solid currentColor;
    border-right: 1px solid currentColor;
    transform: translateY(-50%) rotate(45deg);
  }

  .submit:hover .submit__arrow {
    width: 3.25rem;
  }

  .submit[disabled] {
    opacity: 0.5;
    cursor: default;
  }

  .form__status {
    font-size: var(--fs-small);
    color: var(--ink-soft);
    margin: 0;
  }

  .form__status[data-state='error'] {
    color: var(--accent-ink);
  }

  .form__hint {
    margin: 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    color: var(--ink-faint);
    letter-spacing: 0.08em;
    text-transform: none;
    line-height: 1.6;
    max-width: 52ch;
  }

  @media (max-width: 620px) {
    .form__row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.querySelector('[data-contact-form]');

  if (form instanceof HTMLFormElement) {
    const status = form.querySelector('[data-form-status]');
    const hint = form.querySelector('[data-form-hint]');
    const button = form.querySelector('button[type="submit"]');
    const endpoint = form.dataset.endpoint;

    const setStatus = (message, state) => {
      if (!(status instanceof HTMLElement)) return;
      status.textContent = message;
      if (state) status.dataset.state = state;
      else delete status.dataset.state;
    };

    // clear the invalid flag as soon as the visitor starts fixing a field
    form.addEventListener('input', (e) => {
      const field = e.target;
      if (field instanceof HTMLElement && field.getAttribute('aria-invalid') === 'true') {
        field.removeAttribute('aria-invalid');
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // native constraint validation, surfaced on the fields themselves
      const invalid = [...form.elements].filter(
        (el) =>
          (el instanceof HTMLInputElement ||
            el instanceof HTMLTextAreaElement ||
            el instanceof HTMLSelectElement) &&
          !el.checkValidity()
      );

      form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));

      if (invalid.length) {
        invalid.forEach((el) => el.setAttribute('aria-invalid', 'true'));
        setStatus(invalid[0].validationMessage, 'error');
        invalid[0].focus();
        return;
      }

      if (!endpoint) {
        // no delivery address has been supplied, so nothing is sent and
        // nothing pretends to have been sent
        if (hint instanceof HTMLElement) hint.hidden = false;
        setStatus('', null);
        return;
      }

      if (button instanceof HTMLButtonElement) button.disabled = true;
      setStatus(form.dataset.sending || '', null);

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        setStatus(form.dataset.sent || '', null);
      } catch {
        setStatus(form.dataset.failed || '', 'error');
      } finally {
        if (button instanceof HTMLButtonElement) button.disabled = false;
      }
    });
  }
</script>
