---
/**
 * PAGER
 *
 * Previous / next plus a count. Links, not buttons — a page of a list is a
 * place, and should be shareable, bookmarkable and reachable with the back
 * button.
 *
 * Every current filter is carried across by rebuilding the query string from
 * the request rather than from a list of parameter names. Add a filter to a
 * list page and paging keeps it, with no change here.
 */

const { page = 1, perPage = 25, total = 0, url } = Astro.props;

const pages = Math.max(1, Math.ceil(total / perPage));
const current = Math.min(Math.max(1, page), pages);

const first = total === 0 ? 0 : (current - 1) * perPage + 1;
const last = Math.min(current * perPage, total);

function href(target) {
  const next = new URL(url);
  if (target <= 1) next.searchParams.delete('page');
  else next.searchParams.set('page', String(target));
  return next.pathname + next.search;
}
---

{
  total > 0 && (
    <nav class="pager" aria-label="Pagination">
      <p>
        {first}–{last} of {total}
        {pages > 1 && <span> · page {current} of {pages}</span>}
      </p>

      {pages > 1 && (
        <div class="pager__links">
          {current > 1 ? (
            <a class="btn btn--quiet btn--small" href={href(current - 1)} rel="prev">
              Previous
            </a>
          ) : (
            /* rendered rather than omitted so the next link does not jump
               leftwards when the first page is reached */
            <span class="btn btn--quiet btn--small" aria-disabled="true">Previous</span>
          )}

          {current < pages ? (
            <a class="btn btn--quiet btn--small" href={href(current + 1)} rel="next">
              Next
            </a>
          ) : (
            <span class="btn btn--quiet btn--small" aria-disabled="true">Next</span>
          )}
        </div>
      )}
    </nav>
  )
}
