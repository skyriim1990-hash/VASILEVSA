---
/**
 * The opening of every interior page: a small index label, a display-serif
 * title set on its own line, and an optional lead paragraph offset to the
 * right so the page never opens as a centred block.
 *
 * `divider` turns off the label row and the rule under it, for a page that
 * wants to open on its title. It is opt-in rather than derived from `label`
 * being empty, so pages that pass no label keep the header they have.
 */
const { label = '', title, lead = '', count = '', divider = true } = Astro.props;
---

<header class:list={['page-head', !divider && 'page-head--bare']}>
  <div class="shell">
    {
      divider && (
        <div class="page-head__row">
          {label && <p class="micro reveal">{label}</p>}
          {count && <p class="micro page-head__count reveal" data-delay="1">{count}</p>}
        </div>
      )
    }

    <h1 class="page-head__title h1">
      <span class="reveal-line"><span>{title}</span></span>
    </h1>

    {
      lead && (
        <div class="page-head__lead">
          <p class="lead reveal" data-delay="2">{lead}</p>
        </div>
      )
    }
  </div>
</header>

<style>
  .page-head {
    padding-top: clamp(3rem, 8vw, 7rem);
    padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  .page-head__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--gap);
    padding-bottom: clamp(1.5rem, 4vw, 3rem);
    border-bottom: 1px solid var(--rule);
  }

  /* Without the row there is no rule to clear, so the title's own top padding
     goes and the header's opening space comes down — the two used to stack to
     roughly 10rem above the first line of type. */
  .page-head--bare {
    padding-top: clamp(2.25rem, 5vw, 4rem);
  }

  .page-head--bare .page-head__title {
    padding-top: 0;
  }

  /* Matches the opening space on Periods, so the two titles start level. */
  @media (max-width: 760px) {
    .page-head--bare {
      padding-top: 4.25rem;
    }
  }

  .page-head__count {
    color: var(--ink-faint);
  }

  .page-head__title {
    padding-top: clamp(1.5rem, 4vw, 3rem);
    max-width: 18ch;
  }

  .page-head__lead {
    display: flex;
    justify-content: flex-end;
    margin-top: clamp(1.75rem, 4vw, 3rem);
  }

  .page-head__lead .lead {
    width: min(100%, 46ch);
    color: var(--ink-soft);
  }

  @media (max-width: 720px) {
    .page-head__lead {
      justify-content: flex-start;
    }
  }
</style>
