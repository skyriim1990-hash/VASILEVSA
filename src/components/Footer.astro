---
import { useTranslations, path, ROUTES } from '../i18n/utils.js';

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

/* No social links are shown: no real profiles have been supplied and none
   will be invented. Add them here once confirmed. */
---

<footer class="foot">
  <div class="shell">
    <div class="foot__top">
      <div class="foot__mark">
        <p class="foot__mono" aria-hidden="true">{t('site.shortName')}</p>
        <p class="foot__name">Alexandre Vassilev-Vasilevsa<span class="dot">.</span></p>
        <p class="foot__tag serif">{t('footer.tagline')}</p>
      </div>

      <nav class="foot__nav" aria-label={t('footer.nav')}>
        <p class="micro foot__head">{t('footer.nav')}</p>
        <ul>
          {ROUTES.map((r) => (
            <li><a href={path(r.to, lang)} class="foot__link">{t(r.key)}</a></li>
          ))}
        </ul>
      </nav>

      <div class="foot__meta">
        <p class="micro foot__head">{t('site.role')}</p>
        <p class="foot__soft">{t('site.location')}</p>
        <p class="foot__soft foot__soft--note">{t('contact.detailsPending')}</p>
      </div>
    </div>

    <div class="foot__bottom">
      <p class="micro">© {year} Alexandre Vassilev-Vasilevsa. {t('footer.rights')}</p>
      <ul class="foot__legal">
        <li><a href={path('/privacy', lang)}>{t('footer.privacy')}</a></li>
        <li><a href={path('/terms', lang)}>{t('footer.terms')}</a></li>
      </ul>
      <p class="micro foot__credit">{t('footer.credit')}</p>
    </div>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--rule);
    padding-block: clamp(3rem, 6vw, 5.5rem) 2rem;
  }

  .foot__top {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--gap);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .foot__mono {
    font-family: var(--serif);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 0.85;
    margin-bottom: 1.25rem;
  }

  .foot__name {
    font-size: var(--fs-micro);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .foot__tag {
    margin-top: 0.9rem;
    font-size: clamp(1.15rem, 1.9vw, 1.6rem);
    line-height: 1.25;
    color: var(--ink-soft);
    max-width: 22ch;
  }

  .foot__head {
    margin-bottom: 1.25rem;
  }

  .foot__nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .foot__link {
    font-size: var(--fs-small);
    color: var(--ink);
    transition: color 350ms var(--ease);
  }

  .foot__link:hover {
    color: var(--accent-ink);
  }

  .foot__soft {
    font-size: var(--fs-small);
    color: var(--ink-soft);
    max-width: 28ch;
  }

  .foot__soft--note {
    margin-top: 0.6rem;
    color: var(--ink-faint);
  }

  .foot__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem var(--gap);
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule);
  }

  .foot__legal {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--fs-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .foot__legal a:hover {
    color: var(--accent-ink);
  }

  .foot__credit {
    color: var(--ink-faint);
  }

  @media (max-width: 860px) {
    .foot__top {
      grid-template-columns: 1fr 1fr;
      row-gap: clamp(2rem, 6vw, 3rem);
    }

    .foot__mark {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .foot__top {
      grid-template-columns: 1fr;
    }

    .foot__bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
