---
import { useTranslations, path, ROUTES } from '../i18n/utils.js';

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

/* No social links are shown: no real profiles have been supplied and none
   will be invented.

   No copyright line either. The paintings are public domain and their author
   died in 1890 — a notice in his name over them would be a false claim, and
   the one thing this footer must not do is read as an institution. */
---

<footer class="foot">
  <div class="shell">
    <div class="foot__top">
      <div class="foot__mark">
        <p class="foot__mono" aria-hidden="true"></p>
        <p class="foot__name">{t('site.name')}<span class="dot">.</span></p>
        <p class="foot__soft">{t('footer.dates')}</p>
      </div>

      <nav class="foot__nav" aria-label={t('footer.nav')}>
        <p class="micro foot__head">{t('footer.nav')}</p>
        <ul>
          {ROUTES.map((r) => (
            <li><a href={path(r.to, lang)} class="foot__link">{t(r.key)}</a></li>
          ))}
        </ul>
      </nav>

      <div class="foot__meta">
        <p class="micro foot__head">{t('site.role')}</p>
        <p class="foot__soft">{t('site.location')}</p>
      </div>
    </div>

    <div class="foot__bottom">
      {/* The concept disclosure. Quiet, but on every page — it is the one
          statement the site cannot afford to leave to a meta tag. */}
      <p class="micro foot__note">{t('disclosure.short')}</p>
      <ul class="foot__legal">
        <li><a href={path('/privacy', lang)}>{t('footer.privacy')}</a></li>
        <li><a href={path('/terms', lang)}>{t('footer.terms')}</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--rule);
    padding-block: clamp(3rem, 6vw, 5.5rem) 2rem;
  }

  .foot__top {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--gap);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  /* Same box the old text mark had (font-size and line-height set the height);
     the vector mark is drawn inside it as a mask, in the current ink colour. */
  .foot__mono {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    width: 2.2em;
    height: 0.85em;
    margin-bottom: 1.25rem;
    background: currentColor;
    -webkit-mask: url('/vvg-mark.svg') left center / contain no-repeat;
    mask: url('/vvg-mark.svg') left center / contain no-repeat;
  }

  .foot__name {
    font-size: var(--fs-micro);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .foot__head {
    margin-bottom: 1.25rem;
  }

  .foot__nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .foot__link {
    font-size: var(--fs-small);
    color: var(--ink);
    transition: color 350ms var(--ease);
  }

  .foot__link:hover {
    color: var(--accent-ink);
  }

  .foot__soft {
    font-size: var(--fs-small);
    color: var(--ink-soft);
    max-width: 28ch;
  }

  .foot__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem var(--gap);
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule);
  }

  .foot__legal {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--fs-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .foot__legal a:hover {
    color: var(--accent-ink);
  }

  /* The disclosure takes the width it needs; the legal links sit after it and
     drop below on a narrow screen. */
  .foot__note {
    color: var(--ink-faint);
    max-width: 62ch;
    letter-spacing: 0.06em;
    text-transform: none;
    line-height: 1.65;
  }

  @media (max-width: 860px) {
    .foot__top {
      grid-template-columns: 1fr 1fr;
      row-gap: clamp(2rem, 6vw, 3rem);
    }

    .foot__mark {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .foot__top {
      grid-template-columns: 1fr;
    }

    .foot__bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
