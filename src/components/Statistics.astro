---
/**
 * Editorial data points — set as typography on a hairline rule, not as
 * dashboard cards. Each item: { n, l } (numeral, label).
 */
const { items = [], class: className = '' } = Astro.props;
---

<dl class:list={['stats', className]}>
  {
    items.map((item, i) => (
      <div class="stats__item reveal" data-delay={String(i + 1)}>
        <dt class="stats__n serif">{item.n}</dt>
        <dd class="stats__l micro">{item.l}</dd>
      </div>
    ))
  }
</dl>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
    margin: 0;
    border-top: 1px solid var(--rule);
  }

  .stats__item {
    padding-top: clamp(1.25rem, 2.5vw, 2rem);
    padding-right: var(--gap);
  }

  .stats__item + .stats__item {
    border-left: 1px solid var(--rule);
    padding-left: var(--gap);
  }

  .stats__n {
    font-size: clamp(1.9rem, 4.2vw, 3.4rem);
    line-height: 1;
    letter-spacing: -0.02em;
    /* keeps "2014—2015" and "World & Olympic" from ever breaking the row */
    overflow-wrap: break-word;
  }

  /* The homepage band, from 1025px up, where it turns into two columns and
     these three items share one of them — 586px at 1280. The type reaches its
     ceiling there while the column does not, so in three equal thirds
     "Olympic" wanted 204px and had 133px, and break-word cut it in half.

     The third column is sized to its own longest word instead: min-content is
     exactly the width of "Olympic", "World &" is a little shorter and joins
     it on the first line, and the word can neither split nor run past the end
     of the rule. The first two share what is left. Their right padding goes,
     because the grid gap already separates the columns and that padding was
     only narrowing them from the inside; without it their inner width at
     1280px is exactly what it was, so "400+" and "2014—2015" set as before.
     The dividers between the three move to follow the new column widths.

     Only this instance is affected: the Art × Champions page passes
     as-open__stats and keeps the equal thirds and break-word above. Below
     1025px the band is a single column and "Olympic" fits on its own. */
  @media (min-width: 1025px) {
    .as-band__stats {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) min-content;
    }

    .as-band__stats .stats__item {
      padding-right: 0;
    }

    .as-band__stats .stats__item:last-child .stats__n {
      overflow-wrap: normal;
    }
  }

  .stats__l {
    margin: 0.85rem 0 0;
    color: var(--ink-soft);
    max-width: 18ch;
  }

  @media (max-width: 760px) {
    .stats {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .stats__item {
      padding-block: clamp(1.1rem, 4vw, 1.6rem);
      padding-right: 0;
    }

    .stats__item + .stats__item {
      border-left: 0;
      border-top: 1px solid var(--rule);
      padding-left: 0;
    }

    .stats__l {
      margin-top: 0.5rem;
    }
  }
</style>
