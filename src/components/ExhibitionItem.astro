---
import { useTranslations } from '../i18n/utils.js';
import { value } from '../utils/display.js';

/**
 * One row of the exhibitions timeline. Any field that has not been supplied
 * prints as a marked placeholder rather than an invented name or date.
 */
const { item, index = '01', lang = 'en' } = Astro.props;
const t = useTranslations(lang);

const isPlaceholder = !item.title;
/* An empty row states which field belongs there rather than repeating
   "to be added" four times across the line. It reads as the shape of a
   record waiting to be filled, which is what it is. */
const title = item.title || t('ex.phTitle');
const venue = item.venue || t('ex.phVenue');
const place = [item.city, item.country].filter(Boolean).join(', ') || '—';
const typeLabel = item.type === 'solo' ? t('ex.solo') : item.type === 'group' ? t('ex.group') : '';

const Tag = item.url ? 'a' : 'div';
---

<Tag
  class:list={['ex', isPlaceholder && 'is-placeholder', item.url && 'is-link']}
  href={item.url || undefined}
  rel={item.url ? 'noopener noreferrer' : undefined}
  target={item.url ? '_blank' : undefined}
>
  <span class="ex__index micro" aria-hidden="true">{index}</span>
  <span class="ex__year serif">{value(item.year)}</span>

  <span class="ex__main">
    <span class="ex__title">{title}</span>
    <span class="ex__venue">{venue}</span>
  </span>

  <span class="ex__place">{place}</span>
  <span class="ex__type micro">{typeLabel}</span>
</Tag>

<style>
  .ex {
    display: grid;
    grid-template-columns: 3rem 7rem minmax(0, 2.2fr) minmax(0, 1.2fr) 7rem;
    align-items: baseline;
    gap: var(--gap);
    padding-block: clamp(1.15rem, 2.4vw, 1.75rem);
    border-bottom: 1px solid var(--rule);
    transition: background-color 500ms var(--ease);
  }

  .ex.is-link:hover {
    background: var(--paper-deep);
  }

  .ex__index {
    color: var(--ink-faint);
  }

  .ex__year {
    font-size: clamp(1.35rem, 2.2vw, 1.9rem);
    line-height: 1;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .ex__title {
    display: block;
    font-size: var(--fs-lead);
    line-height: 1.3;
    color: var(--ink);
  }

  .ex__venue {
    display: block;
    margin-top: 0.3rem;
    font-size: var(--fs-small);
    color: var(--ink-soft);
  }

  .ex__place {
    font-size: var(--fs-small);
    color: var(--ink-soft);
  }

  .ex__type {
    text-align: right;
    color: var(--ink-faint);
  }

  /* placeholder rows sit back so they never read as a real record */
  .is-placeholder .ex__title,
  .is-placeholder .ex__venue,
  .is-placeholder .ex__place,
  .is-placeholder .ex__year {
    color: var(--ink-faint);
  }

  /* no italic here: Golos Text ships no italic cut, so the browser would
     synthesise a slanted one. The lighter tone carries the distinction. */

  @media (max-width: 900px) {
    .ex {
      grid-template-columns: 2.5rem minmax(0, 1fr) auto;
      row-gap: 0.4rem;
    }

    .ex__index {
      grid-row: 1 / 3;
    }

    .ex__year {
      grid-column: 2;
      font-size: 1.15rem;
    }

    .ex__type {
      grid-column: 3;
      grid-row: 1;
    }

    .ex__main {
      grid-column: 2 / -1;
    }

    .ex__place {
      grid-column: 2 / -1;
      margin-top: 0.15rem;
    }
  }

  @media (max-width: 480px) {
    .ex {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .ex__index {
      display: none;
    }

    .ex__year {
      grid-column: 1;
    }

    .ex__type {
      grid-column: 2;
    }

    .ex__main,
    .ex__place {
      grid-column: 1 / -1;
    }
  }
</style>
