---
import Media from './Media.astro';
import { useTranslations, path } from '../i18n/utils.js';
import { displayTitle, displayAlt, value, categoryLabel, tone } from '../utils/display.js';

const {
  artwork,
  index = '01',
  lang = 'en',
  /** overrides the ratio from the data — used by the composed homepage spread */
  ratio,
  tone: toneOverride,
  sizes = '(max-width: 720px) 92vw, (max-width: 1200px) 45vw, 30vw',
  priority = false,
  class: className = '',
} = Astro.props;

const t = useTranslations(lang);
const title = displayTitle(artwork, t, index);
const alt = displayAlt(artwork, t, index);
---

<a
  href={path(`/works/${artwork.id}`, lang)}
  class:list={['card', className]}
  aria-label={title}
>
  <div class="card__frame">
    <Media
      src={artwork.image}
      alt={alt}
      ratio={ratio || artwork.ratio}
      label={t('ph.artwork')}
      index={index}
      tone={toneOverride ?? tone(Number(index))}
      sizes={sizes}
      priority={priority}
    />
    <span class="card__arrow" aria-hidden="true"></span>
  </div>

  <div class="card__meta">
    <span class="card__index" aria-hidden="true">{index}</span>
    <span class="card__body">
      <span class="card__title">{title}</span>
      <span class="card__sub">
        <span>{categoryLabel(artwork.category)}</span>
        <span class="card__sep" aria-hidden="true">·</span>
        <span>{value(artwork.year)}</span>
      </span>
    </span>
  </div>
</a>

<style>
  .card {
    display: block;
  }

  .card__frame {
    position: relative;
    overflow: hidden;
  }

  /* the only movement on the image: a very slow, very small scale */
  .card:hover :global(.media__img),
  .card:focus-visible :global(.media__img) {
    transform: scale(1.028);
  }

  .card__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--ink);
    opacity: 0;
    transition: opacity 700ms var(--ease);
    pointer-events: none;
  }

  .card:hover .card__frame::after,
  .card:focus-visible .card__frame::after {
    opacity: 0.04;
  }

  .card__arrow {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--rule);
    background: var(--paper);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 500ms var(--ease), transform 500ms var(--ease);
  }

  .card__arrow::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 6px;
    height: 6px;
    border-top: 1px solid var(--ink);
    border-right: 1px solid var(--ink);
    transform: translate(-60%, -50%) rotate(45deg);
  }

  .card:hover .card__arrow,
  .card:focus-visible .card__arrow {
    opacity: 1;
    transform: none;
  }

  .card__meta {
    display: flex;
    gap: 0.9rem;
    padding-top: 0.95rem;
  }

  .card__index {
    font-family: var(--serif);
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--ink-faint);
    flex: none;
    transition: color 400ms var(--ease);
  }

  .card:hover .card__index {
    color: var(--accent-ink);
  }

  .card__body {
    display: block;
    min-width: 0;
  }

  .card__title {
    display: block;
    font-size: var(--fs-small);
    color: var(--ink);
    transition: color 400ms var(--ease);
  }

  .card:hover .card__title {
    color: var(--accent-ink);
  }

  .card__sub {
    display: flex;
    align-items: baseline;
    gap: 0.5em;
    margin-top: 0.15rem;
    font-size: var(--fs-micro);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .card__sep {
    color: var(--rule);
  }
</style>
