---
/**
 * /admin/forgot-password
 *
 * Asks Supabase to email a recovery link. The link lands on
 * /admin/auth/callback, which turns it into a session and forwards to
 * /admin/reset-password.
 *
 * ---------------------------------------------------------------------------
 * WHY THIS EXISTS WHEN login.astro ONCE ARGUED IT SHOULD NOT
 * ---------------------------------------------------------------------------
 * The original panel had no reset flow on the reasoning that a one-person
 * admin panel gains an entry point and very little else — the dashboard can
 * send a recovery email, so the capability was never missing, only the page
 * that receives it.
 *
 * That reasoning had a hole: the dashboard's own email is built from the
 * project's Site URL, and nothing in this repository controls that value. It
 * pointed at localhost:3000 and the link was unusable. Passing an explicit
 * `redirectTo` from the app is the only way the destination is decided by code
 * that can be read and reviewed here.
 *
 * What it costs: a form that will accept any address and send mail. That is
 * bounded by Supabase's own hourly rate limit and by the fact that a link only
 * ever grants the account it belongs to.
 *
 * ---------------------------------------------------------------------------
 * WHY THE ANSWER IS THE SAME WHATEVER THE ADDRESS
 * ---------------------------------------------------------------------------
 * Supabase returns success for an address it has never seen. This page keeps
 * that: a form that says "no such account" is a form that confirms which
 * addresses do have one. The exceptions are failures that are not about the
 * address at all — a rate limit or missing credentials — because hiding those
 * leaves someone waiting for an email that was never going to arrive.
 */

export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import Field from '../../components/admin/Field.astro';
import Note from '../../components/admin/Note.astro';
import { createSupabaseServerClient } from '../../lib/supabase/server.js';
import { str } from '../../lib/admin/forms.js';
import { recoveryRedirectTo, describeAuthError } from '../../lib/admin/recovery.js';

const configured = !Astro.locals.supabaseMissing;

let error = '';
let sent = false;
let email = '';

if (Astro.request.method === 'POST') {
  if (!configured) {
    error = 'Supabase is not configured on this server.';
  } else {
    const form = await Astro.request.formData();
    email = str(form, 'email');

    if (!email) {
      error = 'Enter the email address the account was created with.';
    } else {
      const supabase = createSupabaseServerClient(Astro);

      const { error: authError } = await supabase.auth.resetPasswordForEmail(email, {
        redirectTo: recoveryRedirectTo(Astro),
      });

      if (authError) {
        error = describeAuthError(authError);
      } else {
        /* Sent, or the address does not exist. Deliberately indistinguishable.

           The request also left a code verifier in a cookie on this browser —
           the callback needs it to exchange the link for a session, which is
           why the link has to be opened in the same browser it was asked
           for from. */
        sent = true;
      }
    }
  }
}
---

<AdminLayout title="Reset password" chrome={false}>
  <div class="login">
    <div class="login__box">
      <h1 class="login__brand">
        Vasilevsa<span>.</span>
        <small>Reset password</small>
      </h1>

      {!configured && (
        <Note
          tone="error"
          text="Supabase credentials are missing from this server's environment. Fill PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_ANON_KEY in .env and restart."
        />
      )}

      {error && <Note tone="error" text={error} />}

      {
        sent ? (
          <>
            <Note
              tone="ok"
              text="If that address has an account, a recovery link is on its way. It expires in an hour and works once."
            />

            <Note
              tone="warn"
              text="Open the link in this browser. The request left a one-time key here that the link is checked against, so a link opened on a different device or in a private window cannot be completed."
            />

            <a class="login__back" href="/admin/login">← Back to sign in</a>
          </>
        ) : (
          <>
            <form class="login__form" method="POST" data-forgot>
              <Field
                name="email"
                label="Email"
                type="email"
                value={email}
                required
                autocomplete="username"
                inputmode="email"
                hint="The address the Supabase account was created with."
                disabled={!configured}
              />

              <button type="submit" class="btn" disabled={!configured || undefined} data-submit>
                Email me a link
              </button>
            </form>

            <a class="login__back" href="/admin/login">← Back to sign in</a>
          </>
        )
      }
    </div>
  </div>
</AdminLayout>

<script>
  /* Same busy state as the sign-in form, and for the same reason: sending mail
     is slow enough to look broken. The form submits normally without this. */
  const form = document.querySelector('[data-forgot]');
  const button = document.querySelector('[data-submit]');

  if (form instanceof HTMLFormElement && button instanceof HTMLButtonElement) {
    let sending = false;

    form.addEventListener('submit', (event) => {
      if (!form.checkValidity()) return;

      if (sending) {
        event.preventDefault();
        return;
      }

      sending = true;
      button.textContent = 'Sending…';
      button.setAttribute('aria-disabled', 'true');
    });
  }
</script>
