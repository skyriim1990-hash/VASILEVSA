---
/**
 * /admin/reset-password
 *
 * The end of the recovery flow: two password boxes, spent against the session
 * the callback just established.
 *
 * ---------------------------------------------------------------------------
 * WHY THIS PAGE IS OPEN IN THE MIDDLEWARE
 * ---------------------------------------------------------------------------
 * Everything else under /admin/ requires a row in public.admin_users. This one
 * cannot: the whole point is that someone is locked out, and the recovery link
 * grants a session that has not yet been anywhere near the allowlist check.
 *
 * It is not unguarded. `updateUser` changes the password of the account in the
 * session and no other, so the worst a stranger can do here is arrive without
 * a session and be told to ask for a link. Nothing on this page reads or
 * writes site content, so the RLS boundary is untouched either way.
 *
 * ---------------------------------------------------------------------------
 * WHY IT SIGNS YOU OUT AFTERWARDS
 * ---------------------------------------------------------------------------
 * A password reset is what you do when you think someone else may have the old
 * one. Ending only the current session would leave theirs running. `signOut`
 * with a global scope revokes every refresh token on the account, so the reset
 * actually costs the other party their access, and the one round trip through
 * the sign-in form proves the new password works.
 */

export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import Field from '../../components/admin/Field.astro';
import Note from '../../components/admin/Note.astro';
import { createSupabaseServerClient } from '../../lib/supabase/server.js';
import { str } from '../../lib/admin/forms.js';
import {
  MIN_PASSWORD_LENGTH,
  validatePassword,
  describeAuthError,
} from '../../lib/admin/recovery.js';

const configured = !Astro.locals.supabaseMissing;

/* Set by the middleware from a verified token, not from the cookie's own
   claims — see getSessionUser in lib/supabase/server.js. */
const user = Astro.locals.user ?? null;

let errors = [];

if (Astro.request.method === 'POST') {
  if (!configured) {
    errors = ['Supabase is not configured on this server.'];
  } else if (!user) {
    errors = ['The recovery session has expired. Ask for a new link.'];
  } else {
    const form = await Astro.request.formData();

    /* Not `str` — that trims, and a trimmed password is a different password
       from the one that was typed. Leading and trailing spaces are legitimate
       characters here and a password manager may well have generated them. */
    const password = String(form.get('password') ?? '');
    const confirm = String(form.get('confirm') ?? '');

    errors = validatePassword(password, confirm);

    if (errors.length === 0) {
      const supabase = createSupabaseServerClient(Astro);
      const { error: authError } = await supabase.auth.updateUser({ password });

      if (authError) {
        errors = [describeAuthError(authError)];
      } else {
        /* The password is already changed. A failure from here on is a failure
           to tidy up, not a failure to reset, and must not be reported as one —
           telling someone their reset failed when it succeeded sends them back
           to a form the old password no longer opens. */
        await supabase.auth.signOut({ scope: 'global' });

        return Astro.redirect('/admin/login?reset=1', 303);
      }
    }
  }
}
---

<AdminLayout title="Choose a new password" chrome={false}>
  <div class="login">
    <div class="login__box">
      <h1 class="login__brand">
        Vasilevsa<span>.</span>
        <small>New password</small>
      </h1>

      {!configured && (
        <Note
          tone="error"
          text="Supabase credentials are missing from this server's environment. Fill PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_ANON_KEY in .env and restart."
        />
      )}

      {errors.length > 0 && <Note tone="error" items={errors} />}

      {
        configured && !user ? (
          <>
            <Note
              tone="warn"
              text="There is no recovery session on this browser. Recovery links expire after an hour and work once — this page is reached by following one, not on its own."
            />

            <p class="login__aside">
              <a href="/admin/forgot-password">Request a new link</a>
            </p>
          </>
        ) : (
          <>
            <form class="login__form" method="POST" data-reset>
              <p class="login__aside">
                Setting a new password for <strong>{user?.email}</strong>.
              </p>

              <Field
                name="password"
                label="New password"
                type="password"
                required
                autocomplete="new-password"
                hint={`At least ${MIN_PASSWORD_LENGTH} characters.`}
                disabled={!configured}
              />

              <Field
                name="confirm"
                label="Repeat the password"
                type="password"
                required
                autocomplete="new-password"
                disabled={!configured}
              />

              <button type="submit" class="btn" disabled={!configured || undefined} data-submit>
                Save the new password
              </button>
            </form>

            <a class="login__back" href="/admin/login">← Back to sign in</a>
          </>
        )
      }
    </div>
  </div>
</AdminLayout>

<script>
  /* Mismatch reported while typing rather than after a round trip. The server
     checks the same thing in validatePassword — this only saves the trip. */
  const form = document.querySelector('[data-reset]');
  const button = document.querySelector('[data-submit]');

  if (form instanceof HTMLFormElement && button instanceof HTMLButtonElement) {
    const password = form.querySelector('[name="password"]');
    const confirm = form.querySelector('[name="confirm"]');

    if (password instanceof HTMLInputElement && confirm instanceof HTMLInputElement) {
      const compare = () => {
        /* setCustomValidity puts the message on the browser's own bubble and
           makes checkValidity false, so the busy state below never fires on a
           form that is not going anywhere. */
        confirm.setCustomValidity(
          confirm.value && confirm.value !== password.value ? 'The two passwords do not match.' : ''
        );
      };

      password.addEventListener('input', compare);
      confirm.addEventListener('input', compare);
    }

    let sending = false;

    form.addEventListener('submit', (event) => {
      if (!form.checkValidity()) return;

      if (sending) {
        event.preventDefault();
        return;
      }

      sending = true;
      button.textContent = 'Saving…';
      button.setAttribute('aria-disabled', 'true');
    });
  }
</script>
