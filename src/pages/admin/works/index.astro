---
/**
 * /admin/works — the archive list
 *
 * ---------------------------------------------------------------------------
 * WHY EVERY CONTROL IS IN THE URL
 * ---------------------------------------------------------------------------
 * Search, category, status and page are all query parameters, read on the
 * server and applied by Postgres. Nothing is filtered in JavaScript.
 *
 * The public Works page does filter client-side — it holds twelve items and a
 * filter that feels instant is worth more there than one that survives a
 * reload. This list is built for the opposite case: at two hundred works,
 * fetching all of them to hide most in the browser means a slow page that gets
 * slower every time a work is added. Here the database returns the twenty-five
 * rows being looked at and a count, and a filtered view is a URL that can be
 * bookmarked and shared.
 */

export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import Note from '../../../components/admin/Note.astro';
import Thumb from '../../../components/admin/Thumb.astro';
import Pager from '../../../components/admin/Pager.astro';
import ConfirmAction from '../../../components/admin/ConfirmAction.astro';
import { listArtworks, listCategories } from '../../../lib/admin/queries.js';
import { messageFor, isErrorCode } from '../../../lib/admin/forms.js';

const PER_PAGE = 25;

const supabase = Astro.locals.supabase;
const params = Astro.url.searchParams;

const search = (params.get('q') ?? '').trim();
const categoryId = params.get('category') ?? '';
const status = params.get('status') ?? '';
const page = Math.max(1, Number.parseInt(params.get('page') ?? '1', 10) || 1);

const { data: categories } = await listCategories(supabase);

const { data: artworks, count, error } = await listArtworks(supabase, {
  search,
  categoryId,
  status,
  page,
  perPage: PER_PAGE,
});

const total = count ?? 0;

const categoryOptions = [
  { value: '', label: 'All categories' },
  ...(categories ?? []).map((c) => ({ value: c.id, label: c.label })),
  { value: 'none', label: '— Uncategorised —' },
];

const code = params.get('m') ?? '';
const message = messageFor(code);

/* A filter is in effect — worth saying so, because an empty result under an
   active filter and an empty archive look identical otherwise. */
const filtered = Boolean(search || categoryId || status);
---

<AdminLayout
  title="Works"
  lead="Everything in the artworks table. Only published works reach the public site."
>
  <Fragment slot="actions">
    <a class="btn" href="/admin/works/new">+ Add work</a>
    <a class="btn btn--quiet" href="/admin/categories">Categories</a>
  </Fragment>

  {message && <Note tone={isErrorCode(code) ? 'error' : 'ok'} text={message} />}
  {error && <Note tone="error" text={`Could not read the archive: ${error.message}`} />}

  <form class="filterbar" method="GET" role="search">
    <div class="field">
      <label class="field__label" for="q">Search</label>
      <input type="search" id="q" name="q" value={search} placeholder="Title or slug" />
    </div>

    <div class="field">
      <label class="field__label" for="category">Category</label>
      <select id="category" name="category">
        {categoryOptions.map((opt) => (
          <option value={opt.value} selected={opt.value === categoryId}>{opt.label}</option>
        ))}
      </select>
    </div>

    <div class="field">
      <label class="field__label" for="status">Status</label>
      <select id="status" name="status">
        <option value="" selected={status === ''}>All</option>
        <option value="published" selected={status === 'published'}>Published</option>
        <option value="draft" selected={status === 'draft'}>Draft</option>
      </select>
    </div>

    <div class="filterbar__go">
      <button type="submit" class="btn btn--quiet">Apply</button>
    </div>

    {filtered && (
      <div class="filterbar__go">
        <a class="btn btn--quiet" href="/admin/works">Clear</a>
      </div>
    )}
  </form>

  {
    artworks && artworks.length > 0 ? (
      <>
        <div class="tablewrap">
          <table class="table">
            <thead>
              <tr>
                <th scope="col"><span class="sr-only">Image</span></th>
                <th scope="col">Title</th>
                <th scope="col">Year</th>
                <th scope="col">Category</th>
                <th scope="col">Status</th>
                <th scope="col" class="table__num">Order</th>
                <th scope="col"><span class="sr-only">Actions</span></th>
              </tr>
            </thead>

            <tbody>
              {artworks.map((work) => (
                <tr>
                  <td><Thumb media={work.media} /></td>

                  <td>
                    <a class="table__title" href={`/admin/works/${work.id}`}>
                      {work.title || <em>Untitled</em>}
                    </a>
                    <span class="table__sub">{work.slug}</span>
                  </td>

                  <td>{work.year_display || work.year || '—'}</td>

                  <td>{work.category?.label ?? '—'}</td>

                  <td>
                    <div class="flags">
                      <span class:list={['flag', work.is_published && 'flag--on']}>
                        {work.is_published ? 'Published' : 'Draft'}
                      </span>
                      {work.is_featured && <span class="flag flag--accent">Featured</span>}
                      {work.is_selected && <span class="flag">Selected</span>}
                    </div>
                  </td>

                  <td class="table__num">{work.sort_order}</td>

                  <td>
                    <div class="table__actions">
                      <a class="btn btn--quiet btn--small" href={`/admin/works/${work.id}`}>Edit</a>

                      <ConfirmAction
                        action={`/admin/works/${work.id}`}
                        question={`Delete “${work.title || 'Untitled'}” and its photograph? This cannot be undone.`}
                        fields={{ _action: 'delete', _return: 'list' }}
                      />
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <Pager page={page} perPage={PER_PAGE} total={total} url={Astro.url} />
      </>
    ) : (
      <p class="empty">
        {filtered
          ? 'No work matches those filters.'
          : 'No works yet. Add the first one to begin the archive.'}
      </p>
    )
  }
</AdminLayout>
